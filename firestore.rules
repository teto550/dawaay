rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }

    // نوع الحساب (عميل p / صيدلية h): يتكتب مرة واحدة بس
    match /users/{uid} {
      allow read: if signed() && request.auth.uid == uid;
      allow create: if signed() && request.auth.uid == uid && request.resource.data.role in ['p', 'h'];
    }
    // بيانات العميل: لصاحبها بس
    match /customers/{uid} {
      allow read, write: if signed() && request.auth.uid == uid;
    }
    // الصيدليات: أي مسجّل يقرا، وصاحب الصيدلية بس يكتب
    match /pharmacies/{uid} {
      allow read: if signed();
      allow write: if signed() && request.auth.uid == uid;
    }
    // المخزون: أي مسجّل يقرا، وصاحب الصيدلية بس يعدّل مخزونه
    match /inventory/{id} {
      allow read: if signed();
      allow create, update: if signed() && request.resource.data.p == request.auth.uid
                            && (resource == null || resource.data.p == request.auth.uid);
      allow delete: if signed() && resource.data.p == request.auth.uid;
    }
    // الحجوزات: العميل ينشئ حجزه، والصيدلية تشوف حجوزاتها وتأكدها
    match /reservations/{id} {
      allow read: if signed() && (resource.data.p == request.auth.uid || resource.data.c == request.auth.uid);
      allow create: if signed() && request.resource.data.c == request.auth.uid;
      // الصيدلية تأكد أو ترفض. والعميل يقدر يلغي حجزه هو بس (يغيّر خانة الحالة وبس)
      allow update: if signed() && (
        resource.data.p == request.auth.uid ||
        (resource.data.c == request.auth.uid && request.resource.data.s == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s']))
      );
    }
    // الطلب على الأدوية في المحافظة: عدّادات مجهولة (من غير أي بيانات شخصية)
    match /demand/{id} {
      allow read: if signed();
      allow create: if signed() && request.resource.data.keys().hasOnly(['gov', 'wk', 'gk', 'd', 'n', 'miss'])
                    && request.resource.data.n == 1 && request.resource.data.miss in [0, 1];
      allow update: if signed() && request.resource.data.gk == resource.data.gk && request.resource.data.d == resource.data.d
                    && request.resource.data.n == resource.data.n + 1
                    && request.resource.data.miss in [resource.data.miss, resource.data.miss + 1];
    }
    // الباركود: أي مسجّل يقرا ويضيف
    match /barcodes/{code} {
      allow read, create, update: if signed();
    }
  }
}
